# open-geo — credentials for the demand APIs (demand/, see demand/README.md).
# Copy to `.env` (gitignored) and fill in what you have. Everything here is
# optional: with no key at all the harvest still runs on public autocomplete
# (presence, no volume) and says so per line. Check what is live with:
#   .venv/bin/python -m demand.doctor --geo ru

# --- Yandex Wordstat API — RU/CIS volume (free) -----------------------------
# Current form: an AI Studio / Yandex Cloud API key for a service account with
# the `search-api.webSearch.user` role. https://aistudio.yandex.ru
WORDSTAT_API_KEY=
WORDSTAT_FOLDER_ID=
# Legacy beta form (OAuth token for api.wordstat.yandex.net) — use instead of
# the two above if that is what you were granted.
WORDSTAT_OAUTH_TOKEN=
# Override the base URL only when Yandex moves the endpoint.
WORDSTAT_BASE_URL=

# --- Google Ads Keyword Planner — worldwide volume (free) -------------------
# Google Ads -> Tools -> API Center (developer token, Basic access) plus an
# OAuth desktop client and refresh token.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=

# --- Bing Webmaster keyword research — worldwide impressions (free) ---------
# https://www.bing.com/webmasters -> verify a site -> Settings -> API access.
BING_WEBMASTER_API_KEY=
